<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Authors></Authors>
        <Company></Company>
        <Version>2.0.3.1</Version>
        <Description>Change your own character's race and gender to Lalafell (or other races!)</Description>
        <Copyright></Copyright>
        <PackageProjectUrl>https://github.com/Blaksey/RaceGenderChanger</PackageProjectUrl>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Penumbra.Api" Version="5.19.2" />
    </ItemGroup>

    <ItemGroup>
        <None Update="RaceGenderChanger.json" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
